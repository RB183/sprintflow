# SprintFlow Backend Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://localhost:27017/sprintflow

# Authentication & Session Security
JWT_SECRET=your_jwt_strong_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Transactional Email Configuration (SMTP / Resend / SendGrid / AWS SES)
# If omitted, invite emails are logged safely to the console in development
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM="SprintFlow <no-reply@your-domain.com>"

# Firebase Admin SDK Credentials (Optional for Google OAuth token verification)
FIREBASE_PROJECT_ID=sprint-flow-4cdf8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@sprint-flow-4cdf8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
